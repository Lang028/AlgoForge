@model AlgoForge.ViewModels.Claim.ClaimVerifyViewModel
@{
    Layout = null;
    // Deliberately no navbar/footer: this is the very first thing a one-time attendee
    // sees, before they have any standing in the app at all -- the goal is one clean
    // question ("is this you?"), not the rest of the site around it.
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your photos are ready - Geeked On</title>
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            background: #14141c;
        }

        /* The "photos in the background" -- a real photo from this event, blurred and
           dimmed so the card stays readable. Not a decorative gradient. */
        .backdrop {
            position: fixed;
            inset: -20px;
            background-image: url('@Url.Action("Photo", "Claim", new { token = Model.Token, index = 0 })');
            background-size: cover;
            background-position: center;
            filter: blur(18px);
            transform: scale(1.05);
            z-index: 0;
        }

        .backdrop-overlay {
            position: fixed;
            inset: 0;
            background: rgba(10, 10, 15, .55);
            z-index: 1;
        }

        .card {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(0, 0, 0, .4);
        }

        .card-header {
            background: #0ea5e9;
            color: #fff;
            padding: 1.5rem 1.75rem;
        }

        .card-header .brand {
            font-weight: 800;
            font-size: .95rem;
            opacity: .9;
        }

        .card-header h1 {
            font-size: 1.35rem;
            font-weight: 800;
            margin: .35rem 0 .15rem;
        }

        .card-header .event-name {
            font-size: .85rem;
            opacity: .85;
        }

        .card-body {
            padding: 1.5rem 1.75rem 1.75rem;
        }

        .card-body .intro {
            font-size: .85rem;
            color: #6b7280;
            margin: 0 0 1.25rem;
        }

        .field {
            margin-bottom: 1rem;
        }

        .field label {
            display: block;
            font-size: .8rem;
            font-weight: 600;
            color: #6b7280;
            margin-bottom: .35rem;
        }

        .field input {
            width: 100%;
            box-sizing: border-box;
            background: #f3f4f6;
            border: 1.5px solid transparent;
            border-radius: 12px;
            padding: .7rem .9rem;
            font-size: .9rem;
        }

        .field input:focus {
            background: #fff;
            border-color: #0ea5e9;
            outline: none;
        }

        .field input[readonly] {
            color: #9ca3af;
        }

        .field .hint {
            font-size: .74rem;
            color: #9ca3af;
            margin-top: .3rem;
        }

        .error {
            background: #fef2f2;
            color: #b91c1c;
            border-radius: 10px;
            padding: .65rem .85rem;
            font-size: .83rem;
            margin-bottom: 1rem;
        }

        .btn-submit {
            width: 100%;
            background: #0ea5e9;
            color: #fff;
            border: 0;
            border-radius: 999px;
            font-weight: 700;
            font-size: .95rem;
            padding: .75rem 1rem;
            cursor: pointer;
        }

        .btn-submit:hover { background: #0284c7; }

        .staff-link {
            text-align: center;
            font-size: .78rem;
            color: #9ca3af;
            margin-top: 1.1rem;
        }

        .staff-link a {
            color: #0ea5e9;
            font-weight: 600;
            text-decoration: none;
        }

        .staff-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="backdrop"></div>
    <div class="backdrop-overlay"></div>

    <div class="card">
        <div class="card-header">
            <div class="brand">Geeked On.</div>
            <h1>Your photos are ready</h1>
            <div class="event-name">@Model.EventName</div>
        </div>
        <div class="card-body">
            <p class="intro">To see the album, enter the email your invite was sent to and the link you were given.</p>

            @if (Model.Error is not null)
            {
                <div class="error">@Model.Error</div>
            }

            <form method="post" asp-action="Verify" asp-route-token="@Model.Token">
                @Html.AntiForgeryToken()

                <div class="field">
                    <label for="email">Your email</label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" required autofocus />
                </div>

                <div class="field">
                    <label for="inviteUrl">Your invite link</label>
                    <input type="text" id="inviteUrl" value="@Model.InviteUrl" readonly />
                    <div class="hint">Already filled in, since you arrived from your link.</div>
                </div>

                <button type="submit" class="btn-submit">Open my album</button>
            </form>

            <div class="staff-link">
                Organising an event or shooting one? <a asp-controller="Account" asp-action="Login">Staff sign in</a>.
            </div>
        </div>
    </div>
</body>
</html>
