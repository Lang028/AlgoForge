@model List<AlgoForge.Models.Tag>
@{
    ViewData["Title"] = "My tags";
    var eventId = ViewData["EventId"];
    var eventName = ViewData["EventName"];
    var noAttendeeRecord = ViewData["NoAttendeeRecord"] is true;
}

<h2>@eventName &mdash; My tags</h2>

@if (noAttendeeRecord)
{
    <div class="alert alert-warning">
        You don't have an attendee record for this event yet, so there's nothing to review.
        (In the full build this is set automatically when you claim your invite; for this demo it's seeded directly.)
    </div>
}
else if (!Model.Any())
{
    <p class="text-muted">No one has tagged you in a photo yet.</p>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        @foreach (var tag in Model)
        {
            var photo = tag.PersonDetection?.Photo;
            var statusBadge = tag.Status switch
            {
                AlgoForge.Models.TagStatus.Confirmed => "bg-success",
                AlgoForge.Models.TagStatus.Rejected => "bg-secondary",
                _ => "bg-warning text-dark"
            };

            <div class="card" style="width: 320px;">
                @if (photo is not null)
                {
                    <img src="@photo.BlobUrl" class="card-img-top" alt="Tagged photo" />
                }
                <div class="card-body">
                    <span class="badge @statusBadge mb-2">@tag.Status</span>

                    @if (tag.Status == AlgoForge.Models.TagStatus.Suggested)
                    {
                        <div class="d-flex gap-2">
                            <form method="post" asp-action="Confirm" asp-route-eventId="@eventId" asp-route-tagId="@tag.Id">
                                <button type="submit" class="btn btn-sm btn-success">Confirm</button>
                            </form>
                            <form method="post" asp-action="Reject" asp-route-eventId="@eventId" asp-route-tagId="@tag.Id">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Reject</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<p class="mt-3"><a asp-controller="Photos" asp-action="Index" asp-route-eventId="@eventId">Back to gallery</a></p>
