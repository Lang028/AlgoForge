@{
    ViewData["Title"] = "Invite not valid";
}

<div class="d-flex justify-content-center py-5">
    <div class="gk-panel text-center" style="max-width: 520px; width: 100%;">

        <div style="width:64px;height:64px;border-radius:50%;background:var(--gk-soft);color:var(--gk-muted);font-size:1.6rem;display:flex;align-items:center;justify-content:center;margin:0 auto .9rem;">
            &#9888;
        </div>

        <h2 class="fw-bold" style="color: var(--gk-ink); font-size: 1.3rem;">
            This invite can't be used
        </h2>

        <p class="text-muted mb-0">
            The link may have been withdrawn by the person who sent it, or it may already
            belong to someone else's account. Ask them to send a new one.
        </p>

        <div class="mt-4">
            <a class="btn gk-btn-soft" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>

    </div>
</div>
