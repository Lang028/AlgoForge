@model List<AlgoForge.Models.Attendee>
@{
    ViewData["Title"] = "Attendees";
    var eventId = ViewData["EventId"];
    var eventName = ViewData["EventName"];
}

<div class="gk-hero my-2">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1>Attendees</h1>
            <div class="crumb">AlgoForge <span class="sep">&rsaquo;</span> Events <span class="sep">&rsaquo;</span> @eventName</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="AddAttendee" asp-route-eventId="@eventId" class="btn gk-btn-coral">+ Add attendee</a>
            <a asp-action="ImportAttendees" asp-route-eventId="@eventId" class="btn gk-btn-soft">Import CSV</a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success mt-3">@success</div>
}

@* This page had no error branch, so a failed invite would have shown nothing at all --
   the one outcome the coordinator most needs to see. *@
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (!Model.Any())
{
    <div class="gk-panel text-center text-muted mt-3 py-5">
        <p class="fw-semibold mb-1">No attendees yet.</p>
        <p style="font-size:.85rem;" class="mb-3">Import a CSV of your invitee list, or add people one at a time.</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn gk-btn-coral gk-btn-sm" asp-action="ImportAttendees" asp-route-eventId="@eventId">Import a CSV</a>
            <a class="btn gk-btn-soft gk-btn-sm" asp-action="AddAttendee" asp-route-eventId="@eventId">Add manually</a>
        </div>
    </div>
}
else
{
    <div class="gk-panel mt-3">
        <table class="table gk-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attendee in Model)
                {
                    <tr>
                        <td class="fw-semibold">@attendee.Name</td>
                        <td>@attendee.Email</td>
                        <td>
                            @if (attendee.ClaimedByUserId.HasValue)
                            {
                                <span class="gk-pill violet">Claimed</span>
                            }
                            else
                            {
                                <span class="gk-pill grey">Invited</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <form method="post" asp-action="SendInvite" asp-route-eventId="@eventId" asp-route-attendeeId="@attendee.Id">
                                    <button type="submit" class="btn gk-btn-coral gk-btn-sm">Send invite</button>
                                </form>
                                @* The same link the invite email carries. Surfaced here so a coordinator
                                   can hand it over directly when someone says the email never arrived. *@
                                <button type="button" class="btn gk-btn-soft gk-btn-sm gk-copy-claim"
                                        data-claim-link="@Url.Action("Claim", "Claim", new { token = attendee.InviteToken }, Context.Request.Scheme)"
                                        title="Copy this attendee's invite link">
                                    Copy link
                                </button>
                                <a asp-action="EditAttendee" asp-route-eventId="@eventId" asp-route-attendeeId="@attendee.Id"
                                   class="btn gk-btn-soft gk-btn-sm">Edit</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p class="mt-3"><a class="gk-link" asp-action="Index">&larr; Back to events</a></p>

@section Scripts {
    <script>
        // Copy-to-clipboard for the invite links above. An invite link is a single-use
        // credential -- it is copied on demand rather than printed into the table, so the
        // list can be shown on a projector without handing every token to the room.
        document.querySelectorAll('.gk-copy-claim').forEach(function (button) {
            button.addEventListener('click', async function () {
                var link = button.dataset.claimLink;
                var original = button.textContent.trim();

                try {
                    await navigator.clipboard.writeText(link);
                    button.textContent = 'Copied';
                } catch {
                    // Clipboard access can be refused (permissions, or a non-secure origin).
                    // Falling back to a prompt keeps the link reachable rather than failing
                    // silently at the exact moment someone needs it.
                    window.prompt('Copy this attendee\'s invite link:', link);
                    button.textContent = original;
                    return;
                }

                setTimeout(function () { button.textContent = original; }, 1500);
            });
        });
    </script>
}
