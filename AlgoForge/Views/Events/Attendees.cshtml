@model List<AlgoForge.Models.Attendee>
@{
    ViewData["Title"] = "Attendees";
    var eventId = ViewData["EventId"];
    var eventName = ViewData["EventName"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@eventName &mdash; Attendees</h2>
    <div>
        <a asp-action="AddAttendee" asp-route-eventId="@eventId" class="btn btn-primary">+ Add attendee</a>
        <a asp-action="ImportAttendees" asp-route-eventId="@eventId" class="btn btn-outline-primary">Import CSV</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (!Model.Any())
{
    <p>
        No attendees yet.
        <a asp-action="ImportAttendees" asp-route-eventId="@eventId">Import a CSV</a>
        or <a asp-action="AddAttendee" asp-route-eventId="@eventId">add one manually</a>.
    </p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Claimed</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attendee in Model)
            {
                <tr>
                    <td>@attendee.Name</td>
                    <td>@attendee.Email</td>
                    <td>
                        @if (attendee.ClaimedByUserId.HasValue)
                        {
                            <span class="badge bg-success">Claimed</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Not claimed</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <form method="post" asp-action="SendInvite" asp-route-eventId="@eventId" asp-route-attendeeId="@attendee.Id">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Send invite</button>
                            </form>
                            <a asp-action="EditAttendee" asp-route-eventId="@eventId" asp-route-attendeeId="@attendee.Id"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="mt-3"><a asp-action="Index">Back to events</a></p>
