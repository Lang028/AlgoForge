@model AlgoForge.ViewModels.Events.AttendeeFormViewModel
@{
    ViewData["Title"] = "Add attendee — " + Model.EventName;
}

<div class="gk-hero my-2">
    <h1>Add attendee</h1>
    <div class="crumb">Geeked On <span class="sep">&rsaquo;</span> @Model.EventName <span class="sep">&rsaquo;</span> Attendees</div>
</div>

<div class="gk-panel gk-form mt-3" style="max-width: 560px;">
    <form method="post" asp-action="AddAttendee" asp-route-eventId="@Model.EventId">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Full name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="person@example.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ContactInfo" class="form-label"></label>
            <input asp-for="ContactInfo" class="form-control" placeholder="Phone, LinkedIn, ... (optional)" />
            <div class="form-text">Optional -- add it now if you know it, or fill it in later.</div>
            <span asp-validation-for="ContactInfo" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn gk-btn-coral">Add attendee</button>
            <a asp-action="Attendees" asp-route-eventId="@Model.EventId" class="btn gk-btn-soft">Cancel</a>
        </div>
    </form>
</div>
