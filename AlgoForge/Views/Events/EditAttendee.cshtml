@model AlgoForge.ViewModels.Events.AttendeeFormViewModel
@{
    ViewData["Title"] = "Edit attendee — " + Model.EventName;
}

<div class="gk-hero my-2">
    <h1>Edit attendee</h1>
    <div class="crumb">AlgoForge <span class="sep">&rsaquo;</span> @Model.EventName <span class="sep">&rsaquo;</span> Attendees</div>
</div>

@if (Model.IsClaimed)
{
    <div class="alert alert-warning mt-3">
        This person has already claimed their invite. Changing their email here won't change the
        address they sign in with &mdash; it only updates their contact card.
    </div>
}

<div class="gk-panel gk-form mt-3" style="max-width: 560px;">
    <form method="post"
          asp-action="EditAttendee"
          asp-route-eventId="@Model.EventId"
          asp-route-attendeeId="@Model.AttendeeId">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ContactInfo" class="form-label"></label>
            <input asp-for="ContactInfo" class="form-control" placeholder="Phone, LinkedIn, ... (optional)" />
            <div class="form-text">Optional -- leave blank if you don't have it.</div>
            <span asp-validation-for="ContactInfo" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn gk-btn-coral">Save changes</button>
            <a asp-action="Attendees" asp-route-eventId="@Model.EventId" class="btn gk-btn-soft">Cancel</a>
        </div>
    </form>
</div>
