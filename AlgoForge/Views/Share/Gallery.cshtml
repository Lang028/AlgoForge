@model AlgoForge.ViewModels.Share.SharedGalleryViewModel

@{
    ViewData["Title"] = Model.EventName;
}

<style>
    .sg-hero {
        background: #14141c;
        border-radius: 24px;
        padding: 2.5rem 2rem;
        color: #fff;
        margin-top: .5rem;
    }

    .sg-hero h1 { font-weight: 800; font-size: 2rem; margin-bottom: .25rem; }
    .sg-hero .meta { color: rgba(255,255,255,.6); font-size: .85rem; }

    .sg-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem;
        margin: 1.5rem 0 3rem;
    }

    .sg-tile {
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        background: #14141c;
        aspect-ratio: 1 / 1;
    }

    .sg-tile img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .sg-dl {
        position: absolute;
        right: .5rem;
        bottom: .5rem;
        background: rgba(20,20,28,.75);
        color: #fff;
        border-radius: 999px;
        padding: .3rem .8rem;
        font-size: .75rem;
        font-weight: 600;
        text-decoration: none;
        backdrop-filter: blur(4px);
    }

    .sg-dl:hover { background: #0ea5e9; color: #fff; }
</style>

<div class="sg-hero">
    <h1>@Model.EventName</h1>
    <div class="meta">@Model.EventDate.ToString("dd MMM yyyy") &middot; @Model.PhotoIds.Count photo@(Model.PhotoIds.Count == 1 ? "" : "s")</div>
</div>

@if (!Model.PhotoIds.Any())
{
    <div class="text-center text-muted py-5">
        <p class="mb-1 fw-semibold">No photos here yet.</p>
        <p style="font-size:.85rem;">Check back once the photographer has uploaded them.</p>
    </div>
}
else
{
    <div class="sg-grid">
        @foreach (var id in Model.PhotoIds)
        {
            <div class="sg-tile">
                @* Same endpoint the signed-in gallery uses. It re-checks the cookie on every
                   request rather than trusting that this page rendered at all. *@
                <img src="@Url.Action("File", "Photos", new { id })" alt="Event photo" loading="lazy" />
                <a class="sg-dl" href="@Url.Action("Download", "Photos", new { id })">Download</a>
            </div>
        }
    </div>
}
