@{
    ViewData["Title"] = "Gallery not found";
}

<div class="gk-hero my-2">
    <h1>This link doesn't work</h1>
    <div class="crumb">AlgoForge <span class="sep">&rsaquo;</span> Gallery</div>
</div>

<div class="gk-panel mt-3" style="max-width: 560px;">
    <p>
        Either the address was mistyped, or whoever shared this gallery has since replaced
        the link.
    </p>
    <p class="text-muted" style="font-size:.85rem;">
        Ask them for the current one &mdash; older links stop working as soon as a new one is
        issued.
    </p>
</div>
