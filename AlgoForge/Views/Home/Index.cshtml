@model AlgoForge.ViewModels.Home.DashboardViewModel
@using AlgoForge.Models
@{
    ViewData["Title"] = "Dashboard";

    var role = Model.ActiveRole;
    // No claim (older cookie) falls back to the full coordinator-style view.
    var isAdmin = role == EventRole.Admin;
    var isCoordinator = role is EventRole.Coordinator or null;
    var isPhotographer = role == EventRole.Photographer;
    var isAttendeeSide = role is EventRole.Attendee or EventRole.Delegate;

    var userInitial = string.IsNullOrEmpty(Model.UserDisplayName)
        ? "?" : Model.UserDisplayName[0].ToString().ToUpper();
    var dayLabels = Model.UploadsLast7Days.Select(u => u.Day.ToString("ddd")).ToList();
    var dayCounts = Model.UploadsLast7Days.Select(u => u.Count).ToList();
}

<style>
    body {
        background: #e9eaee;
    }

    .dash-shell {
        background: #f7f7f9;
        border-radius: 24px;
        padding: 1.25rem;
        box-shadow: 0 20px 60px rgba(30, 30, 50, .12);
    }

    /* ---------- sidebar ---------- */
    .dash-sidebar .side-card {
        background: #fff;
        border-radius: 18px;
        padding: 1.25rem;
    }

    .dash-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #0ea5e9;
        color: #fff;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto .5rem;
    }

    .role-chip {
        display: inline-block;
        background: #e0f2fe;
        color: #0ea5e9;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        padding: .25rem .7rem;
        margin-top: .35rem;
    }

    .dash-nav .nav-link {
        color: #6b7280;
        border-radius: 12px;
        padding: .6rem .9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .dash-nav .nav-link.active {
        color: #0ea5e9;
        background: #e0f2fe;
        border-left: 3px solid #0ea5e9;
    }

    .dash-nav .nav-link:hover {
        color: #111;
        background: #f3f4f6;
    }

    .dash-nav .badge-pending {
        background: #0ea5e9;
        color: #fff;
        border-radius: 999px;
        font-size: .65rem;
        font-weight: 700;
        padding: .2rem .5rem;
        margin-left: auto;
    }

    .side-cta {
        background: #14141c;
        color: #fff;
        border-radius: 18px;
        padding: 1.25rem;
    }

    .side-cta .btn {
        background: #fff;
        color: #14141c;
        border-radius: 999px;
        font-weight: 600;
        font-size: .85rem;
    }

    /* ---------- stat cards ---------- */
    .stat-card {
        border-radius: 18px;
        padding: 1.25rem 1.4rem;
        background: #fff;
        height: 100%;
    }

    .stat-card .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-bottom: .75rem;
        background: #f3f4f6;
    }

    .stat-card h3 {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .stat-card small {
        opacity: .75;
    }

    .stat-card.coral {
        background: #0ea5e9;
        color: #fff;
    }

    .stat-card.violet {
        background: #0ea5e9;
        color: #fff;
    }

    .stat-card.coral .stat-icon,
    .stat-card.violet .stat-icon {
        background: rgba(255, 255, 255, .2);
    }

    /* ---------- panels ---------- */
    .panel {
        background: #fff;
        border-radius: 18px;
        padding: 1.25rem 1.4rem;
    }

    .panel h6 {
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .panel .view-all {
        font-size: .8rem;
        text-decoration: none;
        color: #0ea5e9;
        font-weight: 600;
    }

    .dash-table {
        font-size: .85rem;
    }

    .dash-table thead {
        color: #9ca3af;
        font-weight: 500;
        border-bottom: 1px solid #f0f0f2;
    }

    .dash-table td,
    .dash-table th {
        padding: .55rem .25rem;
        border: 0;
    }

    /* ---------- timeline ---------- */
    .event-pill {
        display: inline-block;
        border-radius: 999px;
        padding: .45rem .9rem;
        font-size: .8rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: .65rem;
        text-decoration: none;
    }

    .event-pill:hover { color: #fff; opacity: .88; }

    .event-pill.live { background: #0ea5e9; }
    .event-pill.draft { background: #0ea5e9; }

    .legend-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: .5rem;
    }

    .donut-wrap {
        position: relative;
        width: 170px;
        margin: 0 auto;
    }

    .donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .donut-center strong { font-size: 1.35rem; }
    .donut-center span { font-size: .75rem; color: #9ca3af; }

    .big-number {
        font-size: 2.4rem;
        font-weight: 800;
        color: #0ea5e9;
        line-height: 1;
    }

    .btn-coral-sm {
        background: #0ea5e9;
        color: #fff;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        padding: .35rem .95rem;
        border: 0;
    }

    .btn-coral-sm:hover { background: #0284c7; color: #fff; }

    .btn-soft-sm {
        background: #f3f4f6;
        color: #14141c;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        padding: .35rem .95rem;
        border: 0;
    }

    .btn-soft-sm:hover { background: #e5e7eb; color: #14141c; }
</style>

@if (TempData["InfoMessage"] is string info)
{
    <div class="alert alert-warning rounded-4 my-2">@info</div>
}
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success rounded-4 my-2">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger rounded-4 my-2">@error</div>
}

<div class="dash-shell my-2">
    <div class="row g-3">

        <!-- ============ Sidebar ============ -->
        <div class="col-lg-3 dash-sidebar d-flex flex-column gap-3">
            <div class="side-card text-center">
                <div class="dash-avatar">@userInitial</div>
                <div class="fw-bold">@Model.UserDisplayName</div>
                <div class="role-chip">@(role?.ToString() ?? "Member")</div>
            </div>

            <div class="side-card flex-grow-1">
                <nav class="dash-nav nav flex-column gap-1">
                    <a class="nav-link active" asp-controller="Home" asp-action="Index">&#9632; Dashboard</a>
                    <a class="nav-link" asp-controller="Events" asp-action="Index">&#128197; Events</a>
                    @if (isCoordinator || isAdmin)
                    {
                        <a class="nav-link" asp-controller="Organisations" asp-action="Index">&#127970; Organisations</a>
                    }
                    @* Connecting is an attendee concern (D11) -- a delegate views and downloads on the
                       attendee's behalf but never tags people or answers connection requests, so the
                       link is not offered to them at all. *@
                    @if (role == EventRole.Attendee)
                    {
                        <a class="nav-link" asp-controller="Connections" asp-action="Index">
                            &#129309; Connections
                            @if (Model.PendingConnectionRequests > 0)
                            {
                                <span class="badge-pending">@Model.PendingConnectionRequests</span>
                            }
                        </a>
                    }
                </nav>
            </div>

            @if (isAdmin)
            {
                <div class="side-cta">
                    <div class="fw-bold mb-1">Running an organisation?</div>
                    <small class="d-block mb-3" style="opacity:.7">Create it here &mdash; every event is hosted under one.</small>
                    <a class="btn btn-sm px-3" asp-controller="Organisations" asp-action="Create">Create organisation</a>
                </div>
            }
            else if (isAttendeeSide)
            {
                <div class="side-cta">
                    <div class="fw-bold mb-1">Tagged in photos?</div>
                    <small class="d-block mb-3" style="opacity:.7">Open your event galleries and review the tags waiting for you.</small>
                    <a class="btn btn-sm px-3" asp-controller="Events" asp-action="Index">My events</a>
                </div>
            }
            else
            {
                <div class="side-cta">
                    <div class="fw-bold mb-1">Hosting an event?</div>
                    <small class="d-block mb-3" style="opacity:.7">Create it and invite your attendees.</small>
                    <a class="btn btn-sm px-3" asp-controller="Events" asp-action="Create">Create event</a>
                </div>
            }
        </div>

        <!-- ============ Main column ============ -->
        <div class="col-lg-6 d-flex flex-column gap-3">
            <div class="d-flex align-items-center justify-content-between px-1">
                <h4 class="fw-bold mb-0">Dashboard</h4>
                <small class="text-muted">@DateTime.Now.ToString("dddd, dd MMM yyyy")</small>
            </div>

            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="stat-card">
                        @if (isAdmin)
                        {
                            <div class="stat-icon">&#127970;</div>
                            <h3>@Model.MyOrganisations.Count</h3>
                            <small>My organisations</small>
                        }
                        else
                        {
                            <div class="stat-icon">&#128197;</div>
                            <h3>@Model.TotalEvents</h3>
                            <small>@(isAttendeeSide ? "My events" : "Events")</small>
                        }
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="stat-card coral">
                        @if (isAdmin)
                        {
                            <div class="stat-icon">&#128197;</div>
                            <h3>@Model.TotalEvents</h3>
                            <small>Events hosted</small>
                        }
                        else
                        {
                            <div class="stat-icon">&#128247;</div>
                            <h3>@Model.TotalPhotos</h3>
                            <small>@(isPhotographer ? "Photos uploaded" : "Photos")</small>
                        }
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="stat-card violet">
                        @if (isAttendeeSide)
                        {
                            <div class="stat-icon">&#127991;</div>
                            <h3>@Model.TotalTags</h3>
                            <small>My tags</small>
                        }
                        else
                        {
                            <div class="stat-icon">&#128101;</div>
                            <h3>@Model.TotalAttendees</h3>
                            <small>Attendees</small>
                        }
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        @(isAttendeeSide ? "Gallery activity" : "Photo uploads")
                        <span class="text-muted fw-normal">&middot; last 7 days</span>
                    </h6>
                    <small class="text-muted">@Model.TotalConnections connections</small>
                </div>
                <canvas id="uploadsChart" height="130" class="mt-3"></canvas>
            </div>

            @if (isAdmin)
            {
                <div class="panel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">My organisations</h6>
                        <a class="view-all" asp-controller="Organisations" asp-action="Index">View all</a>
                    </div>
                    <table class="table dash-table mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Contact</th>
                                <th>Events</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.MyOrganisations.Any())
                            {
                                <tr><td colspan="4" class="text-muted">You don't administer any organisation yet.</td></tr>
                            }
                            @foreach (var org in Model.MyOrganisations)
                            {
                                <tr>
                                    <td class="fw-semibold">@org.Name</td>
                                    <td>@org.ContactEmail</td>
                                    <td>@org.EventCount</td>
                                    <td class="text-end">
                                        <a class="btn btn-soft-sm" asp-controller="Organisations" asp-action="Edit" asp-route-id="@org.Id">Manage</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (isCoordinator)
            {
                <div class="panel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Recent attendees</h6>
                        <a class="view-all" asp-controller="Events" asp-action="Index">View all</a>
                    </div>
                    <table class="table dash-table mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Event</th>
                                <th>Status</th>
                                <th>Event date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentAttendees.Any())
                            {
                                <tr><td colspan="4" class="text-muted">No attendees yet.</td></tr>
                            }
                            @foreach (var a in Model.RecentAttendees)
                            {
                                <tr>
                                    <td class="fw-semibold">@a.Name</td>
                                    <td>@a.EventName</td>
                                    <td>
                                        @if (a.Claimed)
                                        {
                                            <span class="badge rounded-pill" style="background:#0ea5e9">Claimed</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary">Invited</span>
                                        }
                                    </td>
                                    <td>@a.EventDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (isPhotographer)
            {
                <div class="panel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Your events</h6>
                        <a class="view-all" asp-controller="Events" asp-action="Index">View all</a>
                    </div>
                    @if (!Model.UpcomingEvents.Any())
                    {
                        <small class="text-muted">No draft or live events. Uploads open while an event is Live.</small>
                    }
                    @foreach (var e in Model.UpcomingEvents)
                    {
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div>
                                <div class="fw-semibold" style="font-size:.9rem;">@e.Name</div>
                                <small class="text-muted">@e.EventDate.ToString("dd MMM yyyy") &middot; @e.Status</small>
                            </div>
                            <div class="d-flex gap-2">
                                <a class="btn btn-coral-sm" asp-controller="Photos" asp-action="Upload" asp-route-eventId="@e.Id">Upload</a>
                                <a class="btn btn-soft-sm" asp-controller="Photos" asp-action="Index" asp-route-eventId="@e.Id">Gallery</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (role == EventRole.Attendee)
            {
                <div class="panel">
                    <h6>Tags waiting for your review</h6>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="big-number">@Model.SuggestedTags</div>
                        <small class="text-muted">
                            suggested tag@(Model.SuggestedTags == 1 ? "" : "s") of you
                            haven't been confirmed or rejected yet. Nothing goes public without your say-so.
                        </small>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-coral-sm" asp-controller="Events" asp-action="Index">Review in my events</a>
                        <a class="btn btn-soft-sm" asp-controller="Connections" asp-action="Index">
                            Connections
                            @if (Model.PendingConnectionRequests > 0)
                            {
                                <span>(@Model.PendingConnectionRequests pending)</span>
                            }
                        </a>
                    </div>
                </div>
            }
            else
            {
                @* Delegate: viewing and downloading a gallery on an attendee's behalf is the whole
                   scope of this role (DelegatesController) -- no tagging, no connections. *@
                <div class="panel">
                    <h6>Your shared galleries</h6>
                    <small class="text-muted d-block mb-3">
                        You're viewing these events on someone else's behalf. Open a gallery to browse
                        and download photos.
                    </small>
                    <a class="btn btn-coral-sm" asp-controller="Events" asp-action="Index">Open my galleries</a>
                </div>
            }
        </div>

        <!-- ============ Right column ============ -->
        <div class="col-lg-3 d-flex flex-column gap-3">
            <div class="panel">
                <h6>Upcoming events</h6>
                @if (!Model.UpcomingEvents.Any())
                {
                    <small class="text-muted">Nothing scheduled.</small>
                }
                @foreach (var e in Model.UpcomingEvents)
                {
                    <div>
                        <a class="event-pill @(e.Status == EventStatus.Live ? "live" : "draft")"
                           asp-controller="Photos" asp-action="Index" asp-route-eventId="@e.Id">
                            @e.Name
                        </a>
                        <div class="text-muted mb-2" style="font-size:.75rem; margin-top:-.35rem;">
                            @e.EventDate.ToString("dd MMM yyyy") &middot; @e.Status
                        </div>
                    </div>
                }
            </div>

            <div class="panel flex-grow-1">
                <h6>@(isAttendeeSide ? "Your tags" : "Tag consent")</h6>
                <div class="donut-wrap">
                    <canvas id="tagsChart" width="170" height="170"></canvas>
                    <div class="donut-center">
                        <strong>@Model.TotalTags</strong>
                        <span>Total tags</span>
                    </div>
                </div>
                <div class="mt-3" style="font-size:.8rem;">
                    <div class="mb-1"><span class="legend-dot" style="background:#e5e7eb"></span>Suggested (@Model.SuggestedTags)</div>
                    <div class="mb-1"><span class="legend-dot" style="background:#0ea5e9"></span>Confirmed (@Model.ConfirmedTags)</div>
                    <div><span class="legend-dot" style="background:#64748b"></span>Rejected (@Model.RejectedTags)</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const dayLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dayLabels));
        const dayCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dayCounts));

        // Highlight today (last bar) in coral, the rest dark â€” like the reference design.
        const barColors = dayCounts.map((_, i) => i === dayCounts.length - 1 ? '#0ea5e9' : '#14141c');

        new Chart(document.getElementById('uploadsChart'), {
            type: 'bar',
            data: {
                labels: dayLabels,
                datasets: [{
                    data: dayCounts,
                    backgroundColor: barColors,
                    borderRadius: 8,
                    barPercentage: 0.45
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f0f0f2' } },
                    x: { grid: { display: false } }
                }
            }
        });

        new Chart(document.getElementById('tagsChart'), {
            type: 'doughnut',
            data: {
                labels: @(Model.TotalTags == 0 ? Html.Raw("['No tags yet']") : Html.Raw("['Suggested', 'Confirmed', 'Rejected']")),
                datasets: [{
                    data: @(Model.TotalTags == 0 ? Html.Raw("[1]") : Html.Raw($"[{Model.SuggestedTags}, {Model.ConfirmedTags}, {Model.RejectedTags}]")),
                    // Rejected was the same sky blue as Confirmed, making the two opposite
                    // outcomes one indistinguishable arc. Slate rather than red: rejecting a
                    // tag is somebody exercising the choice this product is built around, not
                    // an error state to be flagged.
                    backgroundColor: @(Model.TotalTags == 0 ? Html.Raw("['#eceef1']") : Html.Raw("['#e5e7eb', '#0ea5e9', '#64748b']")),
                    borderWidth: 0,
                    cutout: '72%'
                }]
            },
            options: {
                plugins: { legend: { display: false } }
            }
        });
    </script>
}
