@model AlgoForge.ViewModels.Home.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var userName = (User.Identity?.IsAuthenticated ?? false) ? User.Identity!.Name : "Guest";
    var userInitial = string.IsNullOrEmpty(userName) ? "G" : userName![0].ToString().ToUpper();
    var dayLabels = Model.UploadsLast7Days.Select(u => u.Day.ToString("ddd")).ToList();
    var dayCounts = Model.UploadsLast7Days.Select(u => u.Count).ToList();
}

<style>
    body {
        background: #e9eaee;
    }

    .dash-shell {
        background: #f7f7f9;
        border-radius: 24px;
        padding: 1.25rem;
        box-shadow: 0 20px 60px rgba(30, 30, 50, .12);
    }

    /* ---------- sidebar ---------- */
    .dash-sidebar .side-card {
        background: #fff;
        border-radius: 18px;
        padding: 1.25rem;
    }

    .dash-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c5cfc, #f4502a);
        color: #fff;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto .5rem;
    }

    .dash-nav .nav-link {
        color: #6b7280;
        border-radius: 12px;
        padding: .6rem .9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .dash-nav .nav-link.active {
        color: #f4502a;
        background: #fef1ec;
        border-left: 3px solid #f4502a;
    }

    .dash-nav .nav-link:hover {
        color: #111;
        background: #f3f4f6;
    }

    .side-cta {
        background: #14141c;
        color: #fff;
        border-radius: 18px;
        padding: 1.25rem;
    }

    .side-cta .btn {
        background: #fff;
        color: #14141c;
        border-radius: 999px;
        font-weight: 600;
        font-size: .85rem;
    }

    /* ---------- stat cards ---------- */
    .stat-card {
        border-radius: 18px;
        padding: 1.25rem 1.4rem;
        background: #fff;
        height: 100%;
    }

    .stat-card .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-bottom: .75rem;
        background: #f3f4f6;
    }

    .stat-card h3 {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .stat-card small {
        opacity: .75;
    }

    .stat-card.coral {
        background: #f4502a;
        color: #fff;
    }

    .stat-card.violet {
        background: #7c5cfc;
        color: #fff;
    }

    .stat-card.coral .stat-icon,
    .stat-card.violet .stat-icon {
        background: rgba(255, 255, 255, .2);
    }

    /* ---------- panels ---------- */
    .panel {
        background: #fff;
        border-radius: 18px;
        padding: 1.25rem 1.4rem;
    }

    .panel h6 {
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .panel .view-all {
        font-size: .8rem;
        text-decoration: none;
        color: #f4502a;
        font-weight: 600;
    }

    .dash-table {
        font-size: .85rem;
    }

    .dash-table thead {
        color: #9ca3af;
        font-weight: 500;
        border-bottom: 1px solid #f0f0f2;
    }

    .dash-table td,
    .dash-table th {
        padding: .55rem .25rem;
        border: 0;
    }

    /* ---------- timeline ---------- */
    .event-pill {
        display: inline-block;
        border-radius: 999px;
        padding: .45rem .9rem;
        font-size: .8rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: .65rem;
    }

    .event-pill.live { background: #f4502a; }
    .event-pill.draft { background: #7c5cfc; }

    .legend-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: .5rem;
    }

    .donut-wrap {
        position: relative;
        width: 170px;
        margin: 0 auto;
    }

    .donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .donut-center strong { font-size: 1.35rem; }
    .donut-center span { font-size: .75rem; color: #9ca3af; }
</style>

<div class="dash-shell my-2">
    <div class="row g-3">

        <!-- ============ Sidebar ============ -->
        <div class="col-lg-3 dash-sidebar d-flex flex-column gap-3">
            <div class="side-card text-center">
                <div class="dash-avatar">@userInitial</div>
                <div class="fw-bold">@userName</div>
                <small class="text-muted">Geeked On member</small>
            </div>

            <div class="side-card flex-grow-1">
                <nav class="dash-nav nav flex-column gap-1">
                    <a class="nav-link active" asp-controller="Home" asp-action="Index">&#9632; Dashboard</a>
                    <a class="nav-link" asp-controller="Events" asp-action="Index">&#128197; Events</a>
                    <a class="nav-link" asp-controller="Photos" asp-action="Index">&#128247; Photos</a>
                    <a class="nav-link" asp-controller="Connections" asp-action="Index">&#129309; Connections</a>
                    <a class="nav-link" asp-controller="Tags" asp-action="Index">&#127991; Tags</a>
                </nav>
            </div>

            <div class="side-cta">
                <div class="fw-bold mb-1">Hosting an event?</div>
                <small class="d-block mb-3" style="opacity:.7">Create it and invite your attendees.</small>
                <a class="btn btn-sm px-3" asp-controller="Events" asp-action="Create">Create event</a>
            </div>
        </div>

        <!-- ============ Main column ============ -->
        <div class="col-lg-6 d-flex flex-column gap-3">
            <div class="d-flex align-items-center justify-content-between px-1">
                <h4 class="fw-bold mb-0">Dashboard</h4>
                <small class="text-muted">@DateTime.Now.ToString("dddd, dd MMM yyyy")</small>
            </div>

            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="stat-card">
                        <div class="stat-icon">&#128197;</div>
                        <h3>@Model.TotalEvents</h3>
                        <small>Events</small>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="stat-card coral">
                        <div class="stat-icon">&#128247;</div>
                        <h3>@Model.TotalPhotos</h3>
                        <small>Photos uploaded</small>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="stat-card violet">
                        <div class="stat-icon">&#128101;</div>
                        <h3>@Model.TotalAttendees</h3>
                        <small>Attendees</small>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Photo uploads <span class="text-muted fw-normal">&middot; last 7 days</span></h6>
                    <small class="text-muted">@Model.TotalConnections accepted connections</small>
                </div>
                <canvas id="uploadsChart" height="130" class="mt-3"></canvas>
            </div>

            <div class="panel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Recent attendees</h6>
                    <a class="view-all" asp-controller="Events" asp-action="Index">View all</a>
                </div>
                <table class="table dash-table mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Event</th>
                            <th>Status</th>
                            <th>Event date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentAttendees.Any())
                        {
                            <tr><td colspan="4" class="text-muted">No attendees yet.</td></tr>
                        }
                        @foreach (var a in Model.RecentAttendees)
                        {
                            <tr>
                                <td class="fw-semibold">@a.Name</td>
                                <td>@a.EventName</td>
                                <td>
                                    @if (a.Claimed)
                                    {
                                        <span class="badge rounded-pill" style="background:#7c5cfc">Claimed</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary">Invited</span>
                                    }
                                </td>
                                <td>@a.EventDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ============ Right column ============ -->
        <div class="col-lg-3 d-flex flex-column gap-3">
            <div class="panel">
                <h6>Upcoming events</h6>
                @if (!Model.UpcomingEvents.Any())
                {
                    <small class="text-muted">Nothing scheduled.</small>
                }
                @foreach (var e in Model.UpcomingEvents)
                {
                    <div>
                        <span class="event-pill @(e.Status == AlgoForge.Models.EventStatus.Live ? "live" : "draft")">
                            @e.Name
                        </span>
                        <div class="text-muted mb-2" style="font-size:.75rem; margin-top:-.35rem;">
                            @e.EventDate.ToString("dd MMM yyyy") &middot; @e.Status
                        </div>
                    </div>
                }
            </div>

            <div class="panel flex-grow-1">
                <h6>Tag consent</h6>
                <div class="donut-wrap">
                    <canvas id="tagsChart" width="170" height="170"></canvas>
                    <div class="donut-center">
                        <strong>@Model.TotalTags</strong>
                        <span>Total tags</span>
                    </div>
                </div>
                <div class="mt-3" style="font-size:.8rem;">
                    <div class="mb-1"><span class="legend-dot" style="background:#e5e7eb"></span>Suggested (@Model.SuggestedTags)</div>
                    <div class="mb-1"><span class="legend-dot" style="background:#7c5cfc"></span>Confirmed (@Model.ConfirmedTags)</div>
                    <div><span class="legend-dot" style="background:#f4502a"></span>Rejected (@Model.RejectedTags)</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const dayLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dayLabels));
        const dayCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dayCounts));

        // Highlight today (last bar) in coral, the rest dark — like the reference design.
        const barColors = dayCounts.map((_, i) => i === dayCounts.length - 1 ? '#f4502a' : '#14141c');

        new Chart(document.getElementById('uploadsChart'), {
            type: 'bar',
            data: {
                labels: dayLabels,
                datasets: [{
                    data: dayCounts,
                    backgroundColor: barColors,
                    borderRadius: 8,
                    barPercentage: 0.45
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f0f0f2' } },
                    x: { grid: { display: false } }
                }
            }
        });

        new Chart(document.getElementById('tagsChart'), {
            type: 'doughnut',
            data: {
                labels: @(Model.TotalTags == 0 ? Html.Raw("['No tags yet']") : Html.Raw("['Suggested', 'Confirmed', 'Rejected']")),
                datasets: [{
                    data: @(Model.TotalTags == 0 ? Html.Raw("[1]") : Html.Raw($"[{Model.SuggestedTags}, {Model.ConfirmedTags}, {Model.RejectedTags}]")),
                    backgroundColor: @(Model.TotalTags == 0 ? Html.Raw("['#eceef1']") : Html.Raw("['#e5e7eb', '#7c5cfc', '#f4502a']")),
                    borderWidth: 0,
                    cutout: '72%'
                }]
            },
            options: {
                plugins: { legend: { display: false } }
            }
        });
    </script>
}
