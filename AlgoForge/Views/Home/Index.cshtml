@{
    ViewData["Title"] = "Home";
}

<main>
    <section class="row" aria-labelledby="title">
        <h1 id="title">Geeked On</h1>
        <p class="lead">Event photos are full of people you meant to follow up with and never did. Geeked On turns a photo gallery into a consent-based networking layer.</p>
    </section>

    <div class="row">
        <section class="col-md-4">
            <h2>Face pipeline</h2>
            <p>Photos are detected and clustered by face across every album in an event, so a photographer can identify everyone in a few clicks instead of tagging each photo by hand.</p>
        </section>
        <section class="col-md-4">
            <h2>Consent, not a checkbox</h2>
            <p>Every suggested tag is reviewed by the attendee it belongs to before it's confirmed. Nothing is published without their say-so.</p>
        </section>
        <section class="col-md-4">
            <h2>Reconnect after the event</h2>
            <p>Browse the gallery, view profiles, and send connection requests to people you met &mdash; contact details are only shared once a connection is accepted.</p>
        </section>
    </div>
</main>
