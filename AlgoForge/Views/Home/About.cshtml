@{
    ViewData["Title"] = "About";
}

<div class="gk-hero my-2">
    <h1>About AlgoForge</h1>
    <div class="crumb">AlgoForge <span class="sep">&rsaquo;</span> About</div>
    <p class="hero-sub">@ViewBag.Message</p>
</div>

<div class="gk-panel mt-3" style="max-width: 720px;">
    <p>
        AlgoForge turns an event photo gallery into a consent-based networking layer. Faces are
        detected and grouped automatically across every album, so a coordinator identifies each
        person once instead of tagging hundreds of photos by hand.
    </p>
    <p class="mb-0">
        Consent is the mechanic, not a setting. A name only ever appears on a photo once the
        person it belongs to has confirmed it, and contact details are shared only after both
        sides accept a connection request.
    </p>
</div>
