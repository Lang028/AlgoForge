@{
    ViewData["Title"] = "Link didn't work";
}

<div class="gk-hero my-2">
    <h1>That link didn't work</h1>
    <div class="crumb">AlgoForge <span class="sep">&rsaquo;</span> Reset password</div>
</div>

<div class="gk-panel mt-3" style="max-width: 560px;">
    <p>
        Reset links expire, and they only work once &mdash; so if you've already used this
        one, or asked for a newer one, this is expected.
    </p>

    <div class="mt-3">
        <a asp-action="ForgotPassword" class="btn gk-btn-coral gk-btn-sm">Request a new link</a>
    </div>
</div>
