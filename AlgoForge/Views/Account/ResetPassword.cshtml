@model AlgoForge.ViewModels.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Choose a new password";
}

<div class="gk-hero my-2">
    <h1>Choose a new password</h1>
    <div class="crumb">Geeked On <span class="sep">&rsaquo;</span> Reset password</div>
</div>

<div class="gk-panel mt-3" style="max-width: 520px;">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn gk-btn-coral">Set new password</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
