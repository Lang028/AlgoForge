@{
    ViewData["Title"] = "Check your email";
}

<div class="gk-hero my-2">
    <h1>Check your email</h1>
    <div class="crumb">Geeked On <span class="sep">&rsaquo;</span> Reset password</div>
</div>

<div class="gk-panel mt-3" style="max-width: 560px;">
    @* Says the same thing whether or not the address is registered -- see
       AccountController.ForgotPassword for why. *@
    <p>
        If that address has an account with us, a reset link is on its way to it.
    </p>
    <p class="text-muted" style="font-size:.85rem;">
        The link expires after a while, and it only works once. Check your spam folder if it
        doesn't turn up.
    </p>

    <div class="mt-3">
        <a asp-action="Login">Back to sign in</a>
    </div>
</div>
