@model AlgoForge.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
}

<style>
    body {
        background: #e9eaee;
    }

    .auth-wrap {
        display: flex;
        justify-content: center;
        padding: 2.5rem 0 3.5rem;
    }

    .auth-card {
        display: flex;
        width: 100%;
        max-width: 900px;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(20, 20, 28, .14);
    }

    /* ---------- brand panel ---------- */
    .auth-brand {
        flex: 1 1 42%;
        background: #14141c;
        color: #fff;
        padding: 3rem 2.5rem;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .auth-brand::before,
    .auth-brand::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        opacity: .5;
    }

    .auth-brand::before {
        width: 240px;
        height: 240px;
        background: #f4502a;
        top: -70px;
        right: -70px;
    }

    .auth-brand::after {
        width: 220px;
        height: 220px;
        background: #7c5cfc;
        bottom: -80px;
        left: -60px;
    }

    .auth-brand > * { position: relative; z-index: 1; }

    .auth-logo {
        font-weight: 800;
        font-size: 1.35rem;
        letter-spacing: -.01em;
    }

    .auth-logo .dot { color: #f4502a; }

    .auth-brand h2 {
        font-weight: 800;
        font-size: 1.7rem;
        line-height: 1.3;
        margin: 0 0 .75rem;
    }

    .auth-brand p {
        color: rgba(255, 255, 255, .65);
        font-size: .9rem;
        margin: 0;
    }

    .auth-points {
        list-style: none;
        padding: 0;
        margin: 1.5rem 0 0;
        font-size: .85rem;
        color: rgba(255, 255, 255, .8);
    }

    .auth-points li {
        display: flex;
        gap: .6rem;
        align-items: baseline;
        margin-bottom: .6rem;
    }

    .auth-points li::before {
        content: "\2713";
        color: #f4502a;
        font-weight: 700;
    }

    /* ---------- form panel ---------- */
    .auth-form {
        flex: 1 1 58%;
        padding: 3rem 2.75rem;
    }

    .auth-form h1 {
        font-weight: 800;
        font-size: 1.6rem;
        margin-bottom: .35rem;
        color: #14141c;
    }

    .auth-form .sub {
        color: #9ca3af;
        font-size: .88rem;
        margin-bottom: 1.75rem;
    }

    .auth-form .form-label {
        font-size: .8rem;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: .35rem;
    }

    .auth-form .form-control,
    .auth-form .form-select {
        background: #f3f4f6;
        border: 1.5px solid transparent;
        border-radius: 12px;
        padding: .7rem .95rem;
        font-size: .9rem;
    }

    .auth-form .form-control:focus,
    .auth-form .form-select:focus {
        background: #fff;
        border-color: #f4502a;
        box-shadow: 0 0 0 .2rem rgba(244, 80, 42, .12);
    }

    .auth-form .form-check-input:checked {
        background-color: #f4502a;
        border-color: #f4502a;
    }

    .btn-auth {
        background: #f4502a;
        color: #fff;
        border: 0;
        border-radius: 999px;
        font-weight: 700;
        padding: .7rem 1rem;
        width: 100%;
        transition: background .15s;
    }

    .btn-auth:hover { background: #d84523; color: #fff; }

    .auth-alt {
        text-align: center;
        font-size: .85rem;
        color: #6b7280;
        margin-top: 1.5rem;
    }

    .auth-alt a {
        color: #f4502a;
        font-weight: 600;
        text-decoration: none;
    }

    .auth-alt a:hover { text-decoration: underline; }

    .text-danger { font-size: .8rem; }

    @@media (max-width: 767px) {
        .auth-brand { display: none; }
        .auth-form { padding: 2rem 1.5rem; }
    }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-logo">Geeked On<span class="dot">.</span></div>
            <div>
                <h2>Welcome back to your events.</h2>
                <p>Photos, faces, and the people you meant to follow up with &mdash; all in one place.</p>
                <ul class="auth-points">
                    <li>Consent-based face tagging</li>
                    <li>Galleries for every event</li>
                    <li>Reconnect with people you met</li>
                </ul>
            </div>
            <p style="font-size:.75rem;">AlgoForge (Group 12) &middot; Durban University of Technology</p>
        </div>

        <div class="auth-form">
            <h1>Sign in</h1>
            <div class="sub">Enter your details to continue.</div>

            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SelectedRole" class="form-label"></label>
                    <select asp-for="SelectedRole" class="form-select"
                            asp-items="Html.GetEnumSelectList<AlgoForge.Models.EventRole>()">
                        <option value="">-- Select a role --</option>
                    </select>
                    <span asp-validation-for="SelectedRole" class="text-danger"></span>
                </div>

                <div class="mb-4 form-check">
                    <input type="checkbox" class="form-check-input" asp-for="RememberMe" />
                    <label class="form-check-label" asp-for="RememberMe" style="font-size:.85rem; color:#6b7280;">@Html.DisplayNameFor(m => m.RememberMe)</label>
                </div>

                <button type="submit" class="btn-auth">Sign in</button>
            </form>

            <div class="auth-alt">
                New here? <a asp-action="Register">Create an account</a>
                <div class="mt-1">
                    <a asp-controller="Admin" asp-action="Login" style="color:#9ca3af; font-weight:500; font-size:.78rem;">System administrator? Sign in here</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
