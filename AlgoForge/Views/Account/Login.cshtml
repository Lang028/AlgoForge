@model AlgoForge.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
}

<style>
    body {
        background: #e9eaee;
    }

    .auth-wrap {
        display: flex;
        justify-content: center;
        padding: 2.5rem 0 3.5rem;
    }

    .auth-card {
        display: flex;
        width: 100%;
        max-width: 900px;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(20, 20, 28, .14);
    }

    /* ---------- brand panel ---------- */
    .auth-brand {
        flex: 1 1 42%;
        background: #14141c;
        color: #fff;
        padding: 3rem 2.5rem;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }


    .auth-brand > * { position: relative; z-index: 1; }

    .auth-logo {
        font-weight: 800;
        font-size: 1.35rem;
        letter-spacing: -.01em;
    }

    .auth-logo .dot { color: #0ea5e9; }

    .auth-brand h2 {
        font-weight: 800;
        font-size: 1.7rem;
        line-height: 1.3;
        margin: 0 0 .75rem;
    }

    .auth-brand p {
        color: rgba(255, 255, 255, .65);
        font-size: .9rem;
        margin: 0;
    }

    .auth-points {
        list-style: none;
        padding: 0;
        margin: 1.5rem 0 0;
        font-size: .85rem;
        color: rgba(255, 255, 255, .8);
    }

    .auth-points li {
        display: flex;
        gap: .6rem;
        align-items: baseline;
        margin-bottom: .6rem;
    }

    .auth-points li::before {
        content: "\2713";
        color: #0ea5e9;
        font-weight: 700;
    }

    /* ---------- form panel ---------- */
    .auth-form {
        flex: 1 1 58%;
        padding: 3rem 2.75rem;
    }

    .auth-form h1 {
        font-weight: 800;
        font-size: 1.6rem;
        margin-bottom: .35rem;
        color: #14141c;
    }

    .auth-form .sub {
        color: #9ca3af;
        font-size: .88rem;
        margin-bottom: 1.75rem;
    }

    .auth-form .form-label {
        font-size: .8rem;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: .35rem;
    }

    .auth-form .form-control,
    .auth-form .form-select {
        background: #f3f4f6;
        border: 1.5px solid transparent;
        border-radius: 12px;
        padding: .7rem .95rem;
        font-size: .9rem;
    }

    .auth-form .form-control:focus,
    .auth-form .form-select:focus {
        background: #fff;
        border-color: #0ea5e9;
        box-shadow: 0 0 0 .2rem rgba(14, 165, 233, .12);
    }

    .auth-form .form-check-input:checked {
        background-color: #0ea5e9;
        border-color: #0ea5e9;
    }

    .btn-auth {
        background: #0ea5e9;
        color: #fff;
        border: 0;
        border-radius: 999px;
        font-weight: 700;
        padding: .7rem 1rem;
        width: 100%;
        transition: background .15s;
    }

    .btn-auth:hover { background: #0284c7; color: #fff; }

    .auth-alt {
        text-align: center;
        font-size: .85rem;
        color: #6b7280;
        margin-top: 1.5rem;
    }

    .auth-alt a {
        color: #0ea5e9;
        font-weight: 600;
        text-decoration: none;
    }

    .auth-alt a:hover { text-decoration: underline; }

    .text-danger { font-size: .8rem; }

    @@media (max-width: 767px) {
        .auth-brand { display: none; }
        .auth-form { padding: 2rem 1.5rem; }
    }
</style>

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-logo">Geeked On<span class="dot">.</span></div>
            <div>
                <h2>Welcome back to your events.</h2>
                <p>Photos, faces, and the people you meant to follow up with &mdash; all in one place.</p>
                <ul class="auth-points">
                    <li>Consent-based face tagging</li>
                    <li>Galleries for every event</li>
                    <li>Reconnect with people you met</li>
                </ul>
            </div>
            <p style="font-size:.75rem;">Your photos stay yours &mdash; nothing is tagged without your say-so.</p>
        </div>

        <div class="auth-form">
            <h1>Sign in</h1>
            <div class="sub">Enter your details to continue.</div>

            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
 
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                @* No role picker here any more. The role chosen at sign-up is remembered,
                   and an account that has since claimed an invite is shown the attendee
                   side automatically -- see AccountController.ResolveActiveRoleAsync. *@

                <div class="mb-4 form-check">
                    <input type="checkbox" class="form-check-input" asp-for="RememberMe" />
                    <label class="form-check-label" asp-for="RememberMe" style="font-size:.85rem; color:#6b7280;">@Html.DisplayNameFor(m => m.RememberMe)</label>
                </div>

                <button type="submit" class="btn-auth">Sign in</button>
            </form>

            @* Offered only once we know which address is waiting on confirmation, so the
               page never hints at whether an address is registered until the person has
               already proved they know the password for it. *@
            @if (ViewData["UnconfirmedEmail"] is string unconfirmed)
            {
                <form method="post" asp-action="ResendConfirmation" class="mt-2">
                    <input type="hidden" name="email" value="@unconfirmed" />
                    <button type="submit" class="btn btn-link p-0" style="font-size:.82rem;">
                        Resend the confirmation email
                    </button>
                </form>
            }

            <div class="mt-2">
                <a asp-action="ForgotPassword" style="font-size:.82rem;">Forgotten your password?</a>
            </div>

            <div class="auth-alt">
                @* returnUrl is carried across deliberately. An attendee arrives here from an
                   emailed /Claim/{token} link and usually has no account yet, so this is the
                   link they actually take -- without it they register, land on the dashboard,
                   and their invite is never claimed, leaving them with no access to the event
                   they were invited to and no obvious way back. *@
                New here? <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Create an account</a>
                <div class="mt-1">
                    <a asp-controller="Admin" asp-action="Login" style="color:#9ca3af; font-weight:500; font-size:.78rem;">System administrator? Sign in here</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
