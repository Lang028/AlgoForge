@model AlgoForge.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgotten password";
}

<div class="gk-hero my-2">
    <h1>Forgotten your password?</h1>
    <div class="crumb">AlgoForge <span class="sep">&rsaquo;</span> Reset password</div>
</div>

<div class="gk-panel mt-3" style="max-width: 520px;">
    <p>Enter the address you signed up with and we'll send you a link to choose a new password.</p>

    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn gk-btn-coral">Send reset link</button>
    </form>

    <div class="mt-3">
        <a asp-action="Login">Back to sign in</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
