@{
    ViewData["Title"] = "Link didn't work";
}

<div class="gk-hero my-2">
    <h1>That link didn't work</h1>
    <div class="crumb">Geeked On <span class="sep">&rsaquo;</span> Confirm your address</div>
</div>

<div class="gk-panel mt-3" style="max-width: 560px;">
    <p>
        Confirmation links expire, and they only work once. If you've already confirmed this
        address, just sign in.
    </p>
    <p>
        Otherwise, sign in with your email and password and we'll offer to send a fresh link.
    </p>

    <div class="mt-3">
        <a asp-action="Login" class="btn gk-btn-coral gk-btn-sm">Go to sign in</a>
    </div>
</div>
