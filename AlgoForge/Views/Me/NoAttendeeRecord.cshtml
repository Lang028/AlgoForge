@{
    ViewData["Title"] = "My details";
}

<div class="d-flex justify-content-center py-5">
    <div class="gk-panel text-center" style="max-width: 520px; width: 100%;">

        <h2 class="fw-bold" style="color: var(--gk-ink); font-size:1.3rem;">
            You don't have a guest record here yet
        </h2>

        <p class="text-muted mb-0">
            Open the invitation link from your email to claim your place at this event.
            Once you have, this is where you'll edit your details and identify yourself in
            the photographs.
        </p>

        <div class="mt-4">
            <a class="btn gk-btn-soft" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>

    </div>
</div>
