@model AlgoForge.Models.Connection
@{
    ViewData["Title"] = "Connection request";
    var requesterName = string.IsNullOrWhiteSpace(Model.Requester?.DisplayName) ? "Someone" : Model.Requester!.DisplayName;
}

<div class="d-flex justify-content-center py-5">
    <div class="gk-panel" style="max-width: 520px; width: 100%;">
        <div class="text-center mb-3">
            <div style="width:64px;height:64px;border-radius:50%;background:#c1502e;color:#fff;font-size:1.5rem;font-weight:700;display:flex;align-items:center;justify-content:center;margin:0 auto .75rem;">
                @requesterName[0]
            </div>
            <h2 class="fw-bold" style="color:#14141c; font-size:1.4rem;">Connection request</h2>
        </div>

        @if (Model.Status != AlgoForge.Models.ConnectionStatus.Pending)
        {
            <p class="text-muted text-center">
                You already
                @(Model.Status == AlgoForge.Models.ConnectionStatus.Accepted ? "accepted" : "declined")
                this request.
            </p>
            <div class="text-center">
                <a class="btn gk-btn-soft" asp-action="Index">Back to my connections</a>
            </div>
        }
        else
        {
            <p class="text-center" style="font-size:1.05rem;">
                <strong>@requesterName</strong> wants to connect with you@(Model.MetAtEvent is null ? "" : $" â€” you met at {Model.MetAtEvent.Name}").
            </p>
            <p class="text-muted text-center" style="font-size:.85rem;">
                Accepting shares your email and contact details with them, and theirs with you.
                Declining shares nothing. Either way, the event photos stay exactly as they are.
            </p>

            <div class="d-flex gap-2 justify-content-center mt-3">
                <form method="post" asp-action="Accept" asp-route-connectionId="@Model.Id">
                    <button type="submit" class="btn gk-btn-coral">Accept and share details</button>
                </form>
                <form method="post" asp-action="Decline" asp-route-connectionId="@Model.Id">
                    <button type="submit" class="btn gk-btn-soft">Decline</button>
                </form>
            </div>
        }
    </div>
</div>
