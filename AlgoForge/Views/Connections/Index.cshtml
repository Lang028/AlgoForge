@model List<AlgoForge.Models.Connection>
@{
    ViewData["Title"] = "My connections";
    var viewerId = (Guid)ViewData["ViewerId"]!;
    var attendees = ViewData["Attendees"] as List<AlgoForge.Models.Attendee> ?? new List<AlgoForge.Models.Attendee>();

    AlgoForge.Models.Attendee? ContactFor(Guid userId) =>
        attendees.FirstOrDefault(a => a.ClaimedByUserId == userId);

    string NameOf(AlgoForge.Models.Connection c)
    {
        var otherId = c.OtherUserId(viewerId);
        return ContactFor(otherId)?.Name
            ?? (otherId == c.RequesterId ? c.Requester?.DisplayName : c.Receiver?.DisplayName)
            ?? "Someone";
    }

    var incoming = Model.Where(c => c.Status == AlgoForge.Models.ConnectionStatus.Pending && c.ReceiverId == viewerId).ToList();
    var outgoing = Model.Where(c => c.Status == AlgoForge.Models.ConnectionStatus.Pending && c.RequesterId == viewerId).ToList();
    var accepted = Model.Where(c => c.Status == AlgoForge.Models.ConnectionStatus.Accepted).ToList();
}

<style>
    .conn-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .85rem 0;
        border-bottom: 1px solid #f0f0f2;
        flex-wrap: wrap;
    }

    .conn-row:last-child { border-bottom: 0; }

    .conn-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #0ea5e9;
        color: #fff;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .conn-name { font-weight: 600; color: #14141c; }

    .conn-meta { font-size: .8rem; color: #9ca3af; }

    .count-chip {
        background: #e0f2fe;
        color: #0ea5e9;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        padding: .2rem .6rem;
        vertical-align: middle;
    }
</style>

<div class="gk-hero my-2">
    <h1>My connections</h1>
    <div class="crumb">AlgoForge <span class="sep">&rsaquo;</span> Connections</div>
    <p class="hero-sub">A connection shares contact details, nothing else. Event photos stay visible to every member either way.</p>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success mt-3">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-warning mt-3">@error</div>
}

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="gk-panel h-100">
            <h6>Waiting on you <span class="count-chip">@incoming.Count</span></h6>
            @if (!incoming.Any())
            {
                <p class="text-muted mb-0" style="font-size:.88rem;">Nothing to respond to.</p>
            }
            @foreach (var c in incoming)
            {
                <div class="conn-row">
                    <div class="d-flex align-items-center gap-3">
                        <div class="conn-avatar">@NameOf(c)[0]</div>
                        <div>
                            <div class="conn-name">@NameOf(c)</div>
                            @if (c.MetAtEvent is not null)
                            {
                                <div class="conn-meta">Met at @c.MetAtEvent.Name</div>
                            }
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <form method="post" asp-action="Accept" asp-route-connectionId="@c.Id">
                            <button type="submit" class="btn gk-btn-coral gk-btn-sm">Accept</button>
                        </form>
                        <form method="post" asp-action="Decline" asp-route-connectionId="@c.Id">
                            <button type="submit" class="btn gk-btn-soft gk-btn-sm">Decline</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="gk-panel h-100">
            <h6>Sent <span class="count-chip">@outgoing.Count</span></h6>
            @if (!outgoing.Any())
            {
                <p class="text-muted mb-0" style="font-size:.88rem;">No pending requests.</p>
            }
            @foreach (var c in outgoing)
            {
                <div class="conn-row">
                    <div class="d-flex align-items-center gap-3">
                        <div class="conn-avatar">@NameOf(c)[0]</div>
                        <div class="conn-name">@NameOf(c)</div>
                    </div>
                    <span class="gk-pill grey">Awaiting response</span>
                </div>
            }
        </div>
    </div>

    <div class="col-12">
        <div class="gk-panel">
            <h6>Connected <span class="count-chip">@accepted.Count</span></h6>
            @if (!accepted.Any())
            {
                <p class="text-muted mb-0" style="font-size:.88rem;">
                    No connections yet. Open an event gallery and click a face to reach out.
                </p>
            }
            @foreach (var c in accepted)
            {
                var contact = ContactFor(c.OtherUserId(viewerId));
                <div class="conn-row">
                    <div class="d-flex align-items-center gap-3">
                        <div class="conn-avatar">@NameOf(c)[0]</div>
                        <div>
                            <div class="conn-name">@NameOf(c)</div>
                            @if (c.MetAtEvent is not null)
                            {
                                <div class="conn-meta">Met at @c.MetAtEvent.Name</div>
                            }
                        </div>
                    </div>
                    @if (contact is not null)
                    {
                        <div style="font-size:.85rem;">
                            <a class="gk-link" href="mailto:@contact.Email">@contact.Email</a>
                            @if (!string.IsNullOrWhiteSpace(contact.ContactInfo))
                            {
                                <span class="text-muted">&middot; @contact.ContactInfo</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
