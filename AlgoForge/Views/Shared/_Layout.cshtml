@using AlgoForge.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AlgoForgeDbContext Db
@inject UserManager<AlgoForge.Models.ApplicationUser> UserManager
@{
    var currentUserRoles = new List<string>();

    // The platform admin monitors the system and never participates in events, so the
    // event-side navigation is not offered to them at all.
    var isSystemAdmin = User.IsInRole(AlgoForge.Data.DbInitializer.SystemAdminRole);

    // Connecting is an attendee concern -- see ConnectionsController.Index.
    var isAttendee = false;

    if (User.Identity?.IsAuthenticated ?? false)
    {
        var currentUserId = UserManager.GetUserId(User);
        if (currentUserId is not null && Guid.TryParse(currentUserId, out var currentUserGuid))
        {
            var memberships = await Db.EventMemberships
                .Where(m => m.UserId == currentUserGuid)
                .Include(m => m.Event)
                .Select(m => new { m.Role, EventName = m.Event!.Name })
                .ToListAsync();

            currentUserRoles = memberships
                .Select(m => $"{m.Role} @ {m.EventName}")
                .ToList();

            isAttendee = memberships.Any(m => m.Role == AlgoForge.Models.EventRole.Attendee);
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Geeked On</title>
    <link rel="icon" href="~/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark gk-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Geeked On<span class="dot">.</span></a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>

                    @if (isSystemAdmin)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin console</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Outbox" asp-action="Index">Outbox</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>

                        @if (isAttendee)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Connections" asp-action="Index">Connections</a></li>
                        }
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <ul class="navbar-nav align-items-sm-center">
                        <li class="nav-item">
                            <span class="nav-link user-chip">
                                @User.Identity.Name
                                @if (currentUserRoles.Any())
                                {
                                    <span class="badge rounded-pill">@string.Join(", ", currentUserRoles)</span>
                                }
                            </span>
                        </li>
                        <li class="nav-item">
                            <form method="post" asp-controller="Account" asp-action="Logout" style="display: inline;">
                                <button type="submit" class="btn-logout">Logout</button>
                            </form>
                        </li>
                    </ul>
                }
                else
                {
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                    </ul>
                }
            </div>
        </div>
    </nav>
    <div class="container body-content" style="margin-top: 1.5rem;">
        @RenderBody()
        <footer class="gk-footer">
            &copy; @DateTime.Now.Year &middot; Geeked On
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
