@model List<AlgoForge.Models.Organisation>
@{
    ViewData["Title"] = "Organisations";
    var currentUserId = ViewData["CurrentUserId"] as Guid?;
}

<div class="gk-hero my-2">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1>Organisations</h1>
            <div class="crumb">Geeked On <span class="sep">&rsaquo;</span> Organisations</div>
        </div>
        <a asp-action="Create" class="btn gk-btn-coral">+ Create organisation</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="gk-panel text-center text-muted mt-3 py-5">
        <p class="fw-semibold mb-1">No organisations yet.</p>
        <p style="font-size:.85rem;" class="mb-3">Every event is hosted under an organisation &mdash; create one to get started.</p>
        <a class="btn gk-btn-coral gk-btn-sm" asp-action="Create">Create organisation</a>
    </div>
}
else
{
    <div class="gk-panel mt-3">
        <table class="table gk-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact email</th>
                    <th>Admin</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var org in Model)
                {
                    <tr>
                        <td class="fw-semibold">@org.Name</td>
                        <td>@org.ContactEmail</td>
                        <td>@(org.AdminUser?.DisplayName ?? "—")</td>
                        <td class="text-end">
                            @if (org.AdminUserId == currentUserId)
                            {
                                <a asp-action="Edit" asp-route-id="@org.Id" class="btn gk-btn-soft gk-btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@org.Id" class="btn gk-btn-danger gk-btn-sm">Delete</a>
                            }
                            else
                            {
                                <span class="text-muted small">Managed by its admin</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
